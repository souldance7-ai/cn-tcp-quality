#!/usr/bin/env bash
count=5
family=4
l2=0
target="${!#}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    -c) count="$2"; shift 2 ;;
    -6) family=6; shift ;;
    --source-mac) l2=1; shift 2 ;;
    *) shift ;;
  esac
done
if [ -n "${MOCK_DROP_ONCE_DIR:-}" ]; then
  safe_target=${target//[:.]/_}
  marker="$MOCK_DROP_ONCE_DIR/$safe_target"
  if [ ! -e "$marker" ]; then
    : > "$marker"
    printf 'Raw packets sent: %s | Rcvd: 0 | Lost: %s (100.00%%)\n' "$count" "$count"
    exit 0
  fi
fi
if [ "${MOCK_IPV6_NEEDS_L2:-0}" = "1" ] && [ "$family" -eq 6 ] && [ "$l2" -eq 0 ]; then
  printf 'Raw packets sent: %s | Rcvd: 0 | Lost: %s (100.00%%)\n' "$count" "$count"
  exit 0
fi
i=1
while [ "$i" -le "$count" ]; do
  printf 'RCVD TCP response rtt=%s.00ms\n' "$((40+i))"
  i=$((i+1))
done
printf 'Raw packets sent: %s | Rcvd: %s | Lost: 0 (0.00%%)\n' "$count" "$count"
