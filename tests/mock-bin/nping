#!/usr/bin/env bash
count=5
while [ "$#" -gt 0 ]; do
  if [ "$1" = "-c" ]; then count="$2"; shift 2; else shift; fi
done
i=1
while [ "$i" -le "$count" ]; do
  printf 'RCVD TCP response rtt=%s.00ms\n' "$((40+i))"
  i=$((i+1))
done
printf 'Raw packets sent: %s | Rcvd: %s | Lost: 0 (0.00%%)\n' "$count" "$count"
