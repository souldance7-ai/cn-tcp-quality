#!/usr/bin/env bash
# Default behavior forces the main script to exercise its built-in node fallback.
url=""
output=""
is_upload=0
has_follow=0
user_agent=""
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
  case "${args[$i]}" in
    -o) output="${args[$((i+1))]:-}" ;;
    -L|--location) has_follow=1 ;;
    -A|--user-agent) user_agent="${args[$((i+1))]:-}" ;;
    --data-binary) is_upload=1 ;;
    http://*|https://*) url="${args[$i]}" ;;
  esac
done

if [ "${MOCK_HEFEI_STATIC:-0}" != "1" ]; then
  case "$url" in
    *112.122.10.26*|*61.191.111.11*|*112.29.5.6*|*112.29.5.58*) exit 22 ;;
  esac
fi

if [[ "$url" == *'speed.cloudflare.com/__down?'* ]]; then
  printf '200|16777216|25000000|0.030|1.000|1'
  exit 0
fi

if [ "$is_upload" -eq 1 ] && [[ "$url" == *'speed.cloudflare.com/__up'* ]]; then
  printf '200|16777216|12500000|0.040|1.000|1'
  exit 0
fi

if [ "${MOCK_DIRECT_HTTP:-0}" = "1" ] && [[ "$url" == *'/api/js/servers?'* ]]; then
  payload='[
    {"id":"bj-ct","sponsor":"China Telecom Beijing","name":"Beijing","cc":"CN","lat":"39.9042","lon":"116.4074","host":"ct.example:8080","url":"http://ct.example:8080/speedtest/upload.php"},
    {"id":"bj-cu","sponsor":"China Unicom Beijing","name":"Beijing","cc":"CN","lat":"39.9042","lon":"116.4074","host":"cu.example:8080","url":"http://cu.example:8080/speedtest/upload.php"},
    {"id":"bj-cm","sponsor":"China Mobile Beijing","name":"Beijing","cc":"CN","lat":"39.9042","lon":"116.4074","host":"cm.example:8080","url":"http://cm.example:8080/speedtest/upload.php"}
  ]'
  if [ -n "$output" ] && [ "$output" != "/dev/null" ]; then
    printf '%s\n' "$payload" > "$output"
  else
    printf '%s\n' "$payload"
  fi
  exit 0
fi

if [ "${MOCK_SPEEDTEST_CN_ONLY:-0}" = "1" ] && [[ "$url" == *'/speedtest.cn-CN-ID/main/CN.csv'* ]]; then
  payload='id,active,https,cros,preferred,host,country_code,province,city,ver,operator,lon,lat,times,high_speed,sponsor,sponsor_url,current_version,distance,pingUrl,downloadUrl,uploadUrl,websocketUrl
cn-bj-ct,1,0,1,1,ct.example:8080,CN,北京,北京,1,电信,116.4074,39.9042,1,1,北京电信,-,1,0,http://ct.example:8080/speedtest/ping,http://ct.example:8080/speedtest/download?size=104857600,http://ct.example:8080/speedtest/upload.php,-
cn-bj-cu,1,0,1,1,cu.example:8080,CN,北京,北京,1,联通,116.4074,39.9042,1,1,北京联通,-,1,0,http://cu.example:8080/speedtest/ping,http://cu.example:8080/speedtest/download?size=104857600,http://cu.example:8080/speedtest/upload.php,-
cn-bj-cm,1,0,1,1,cm.example:8080,CN,北京,北京,1,移动,116.4074,39.9042,1,1,北京移动,-,1,0,http://cm.example:8080/speedtest/ping,http://cm.example:8080/speedtest/download?size=104857600,http://cm.example:8080/speedtest/upload.php,-'
  if [ -n "$output" ] && [ "$output" != "/dev/null" ]; then
    printf '%s\n' "$payload" > "$output"
  else
    printf '%s\n' "$payload"
  fi
  exit 0
fi

if { [ "${MOCK_DIRECT_HTTP:-0}" = "1" ] || [ "${MOCK_SPEEDTEST_CN_ONLY:-0}" = "1" ] || [ "${MOCK_HEFEI_STATIC:-0}" = "1" ] || [ "${MOCK_OOKLA_ALIAS:-0}" = "1" ]; } &&
   { [[ "$url" == *'/download?'* ]] || [[ "$url" == *'/random4000x4000.jpg?'* ]]; }; then
  if [ "${MOCK_SPEEDTEST_CN_STRICT:-0}" = "1" ]; then
    [ "$has_follow" -eq 1 ] || exit 22
    [[ "$user_agent" == *'Mozilla/5.0'* ]] || exit 22
  fi
  printf '200|12582912|12500000|0.050|1.000|1'
  exit 0
fi

if { [ "${MOCK_DIRECT_HTTP:-0}" = "1" ] || [ "${MOCK_SPEEDTEST_CN_ONLY:-0}" = "1" ] || [ "${MOCK_HEFEI_STATIC:-0}" = "1" ] || [ "${MOCK_OOKLA_ALIAS:-0}" = "1" ]; } &&
   [ "$is_upload" -eq 1 ] && { [[ "$url" == *'/upload.php'* ]] || [[ "$url" == *'/upload'* ]]; }; then
  if [ "${MOCK_SPEEDTEST_CN_STRICT:-0}" = "1" ]; then
    [ "$has_follow" -eq 1 ] || exit 22
    [[ "$user_agent" == *'Mozilla/5.0'* ]] || exit 22
    prefix=$(dd bs=1 count=9 2>/dev/null | od -An -tx1 | tr -d ' \n')
    [ "$prefix" = "000000000000000000" ] || exit 22
  fi
  printf '200|8388608|6250000|0.060|1.000|1'
  exit 0
fi

exit 22
