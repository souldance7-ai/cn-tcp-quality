#!/usr/bin/env bash
mode="${1:-}"
host="${2:-}"
case "$host" in
  ct.example|cu.example|cm.example) ;;
  *.ip.zstaticcdn.com) ;;
  speedtest.jsqiuying.com)
    [ "${MOCK_SPEEDTEST_NET_ONLY:-0}" = "1" ] || exit 2
    ;;
  speed.cloudflare.com) ;;
  speedtest1.ah163.com|speedtest2.ah.chinamobile.com|4gtest.ahydnet.com)
    [ "${MOCK_HEFEI_STATIC:-0}" = "1" ] || exit 2
    ;;
  *.prod.hosts.ooklaserver.net)
    [ "${MOCK_OOKLA_ALIAS:-0}" = "1" ] || exit 2
    ;;
  *) exit 2 ;;
esac
v4_addr=198.51.100.20
v6_addr=2001:db8::20
if [[ "$host" == *.ip.zstaticcdn.com ]]; then
  host_sum=$(printf '%s' "$host" | cksum | awk '{print $1}')
  host_suffix=$((host_sum % 200 + 20))
  v4_addr="198.51.100.$host_suffix"
  v6_addr="2001:db8::$host_suffix"
fi
case "$mode" in
  ahostsv4) printf '%s STREAM %s\n' "$v4_addr" "$host" ;;
  ahostsv6)
    if [ "${MOCK_IPV4_MAPPED_ONLY:-0}" = "1" ]; then
      printf '::ffff:198.51.100.20 STREAM %s\n' "$host"
    else
      printf '%s STREAM %s\n' "$v6_addr" "$host"
    fi
    ;;
  *) exit 2 ;;
esac
